# ─── Supabase ───
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# or use the new publishable key name if required:
# NEXT_PUBLIC_SUPABASE_KEY=your-publishable-key
# NEXT_PUBLIC_SUPABASE_PUBLIC_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# or use the new secret key name if required:
# SUPABASE_SECRET_KEY=your-secret-key
# SUPABASE_KEY=your-secret-key

# ─── Paystack ───
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxx

# ─── OpenAI (Render Preview + AI-expanded dropdown options) ───
OPENAI_API_KEY=sk-xxxxxxxxxxxx

# ─── Email (Resend — for prompt pack delivery) ───
RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL=hello@archiprompts.ai

# ─── App ───
NEXT_PUBLIC_APP_URL=http://localhost:3000
PROMPT_PACK_DOWNLOAD_URL=https://your-project.supabase.co/storage/v1/object/...
